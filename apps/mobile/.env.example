EXPO_PUBLIC_MAPTILER_API_KEY=
# Google Cloud Console → client OAuth de type "Web" (audience de l'ID token,
# même sur Android/iOS — voir GoogleSignin.configure).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# IP locale de la machine qui fait tourner l'API en dev (pas "localhost" —
# le téléphone physique doit pouvoir l'atteindre sur le même Wi-Fi).
EXPO_PUBLIC_API_URL=
