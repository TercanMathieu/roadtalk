EXPO_PUBLIC_MAPTILER_API_KEY=
# Google Cloud Console → client OAuth de type "Web" (audience de l'ID token,
# même sur Android/iOS — voir GoogleSignin.configure).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Google Cloud Console → client OAuth de type "iOS" (bundle ID
# app.roadtalk.mobile). Son identifiant inversé doit aussi figurer dans
# app.json (iosUrlScheme du plugin google-signin). Inutile sur Android.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Optionnel. Laisser vide en dev : l'adresse de l'API est déduite de l'hôte
# Metro auquel l'appareil est déjà connecté (voir src/lib/apiUrl.ts), ce qui
# survit aux changements d'IP. À renseigner seulement pour forcer une cible
# précise : backend distant, ou build de production (où Metro n'existe plus).
EXPO_PUBLIC_API_URL=
