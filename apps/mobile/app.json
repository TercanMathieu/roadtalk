{
  "expo": {
    "name": "RoadTalk",
    "slug": "roadtalk",
    "scheme": "roadtalk",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "app.roadtalk.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "app.roadtalk.mobile"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RoadTalk utilise ta position pour te situer sur la carte.",
          "locationAlwaysAndWhenInUsePermission": "RoadTalk enregistre le tracé de ta balade même quand l'écran est verrouillé. Ta position reste sur ton téléphone jusqu'à ce que tu sauvegardes la balade.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.854119867118-j9lta04gjm17ep9smll6jnhts15s5tnc"
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "2df0c3fc-7f22-4f47-af01-ad8de25a962f"
      }
    }
  }
}
