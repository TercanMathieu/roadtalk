datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  // Nullable : absent tant que l'utilisateur ne l'a pas choisi après sa
  // première connexion (mobile redirige vers l'écran de choix tant que null).
  // Unique autorise plusieurs NULL en Postgres (pas de conflit tant qu'il
  // n'est pas encore renseigné).
  username     String?  @unique
  // Identifiants OAuth : au moins un des deux est renseigné (F1 — Apple ou
  // Google, jamais de mot de passe). C'est le service qui garantit qu'un
  // User n'est créé que via findOrCreateFromOAuth, pas une contrainte ici.
  appleUserId  String?  @unique @map("apple_user_id")
  googleUserId String?  @unique @map("google_user_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  refreshTokens         RefreshToken[]
  addressHistoryEntries AddressHistoryEntry[]
  rides                 Ride[]
  routes                Route[]

  @@map("users")
}

model RefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Jamais le token brut en base — seulement son hash (SHA-256). Un accès en
  // lecture à la base (fuite de backup, etc.) ne doit pas suffire à usurper
  // une session, exactement comme pour un mot de passe.
  tokenHash String @unique @map("token_hash")

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  // Non-null : le token a été utilisé pour un refresh (rotation) ou révoqué
  // explicitement (logout, détection de réemploi). Un token révoqué qu'on
  // tente de réutiliser déclenche la révocation de toutes les sessions du user.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("refresh_tokens")
}

model AddressHistoryEntry {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label     String
  // Nullable, même raison que côté contrat de recherche : le géocodeur ne
  // renvoie pas toujours un élément de situation exploitable.
  context   String?
  latitude  Float
  longitude Float

  // Ni créé, ni modifié au sens CRUD classique : c'est l'instant de la
  // dernière sélection, mis à jour à chaque fois que l'utilisateur reclique
  // la même adresse plutôt que d'empiler une nouvelle ligne (voir la
  // contrainte unique ci-dessous).
  selectedAt DateTime @default(now()) @map("selected_at") @db.Timestamptz(3)

  // Identifie "la même adresse" par sa valeur, faute d'identifiant stable
  // côté géocodeur (Photon ne fournit pas de place ID). Rend l'écriture
  // idempotente par upsert : une sélection répétée met juste selectedAt à
  // jour au lieu de dupliquer la ligne.
  @@unique([userId, label, latitude, longitude])
  // Tri par récence, filtré par utilisateur — exactement le sens de lecture
  // de la requête d'historique.
  @@index([userId, selectedAt])
  @@map("address_history_entries")
}

model Ride {
  id      String @id @default(uuid()) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Éditable par l'utilisateur avant la sauvegarde (voir RideSummaryScreen
  // côté mobile) — jamais vide, un nom par défaut est proposé côté client.
  name String

  startedAt DateTime @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime @map("ended_at") @db.Timestamptz(3)

  // Résumé recalculé côté serveur à partir de `track` (summarizeTrack,
  // domain/summarize-track.ts) — jamais une valeur envoyée telle quelle par
  // le client, qui pourrait l'avoir mal calculée ou falsifiée.
  distanceMeters      Float @map("distance_meters")
  durationSeconds     Float @map("duration_seconds")
  averageSpeedMps     Float @map("average_speed_mps")
  maxSpeedMps         Float @map("max_speed_mps")
  elevationGainMeters Float @map("elevation_gain_meters")

  // Tracé brut (liste de points GPS), pas de colonne géométrique PostGIS :
  // voir ADR-002 — aucune requête spatiale n'existe en V1 (pas de recherche
  // "balades à proximité"), un JSONB suffit à réafficher le tracé sur la
  // carte. À migrer vers `geography(LineString)` + requêtes $queryRaw le
  // jour où un vrai besoin spatial apparaît.
  track Json

  // Mise en avant personnelle d'une balade déjà effectuée — distinct des
  // "Favoris" de l'onglet Historique (qui désigne les itinéraires Route
  // enregistrés, pas encore roulés). Les deux notions coexistent sans se
  // recouper.
  isFavorite Boolean @default(false) @map("is_favorite")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Tri par récence, filtré par propriétaire — exactement le sens de lecture
  // de l'écran Historique/Balades.
  @@index([ownerId, startedAt])
  @@map("rides")
}

model Route {
  id       String @id @default(uuid()) @db.Uuid
  authorId String @map("author_id") @db.Uuid
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Nullable (voir domain/route.entity.ts) : l'utilisateur peut sauvegarder
  // un itinéraire sans lui donner de nom.
  name String?

  // Séquence ordonnée de points, pas de colonne géométrique PostGIS — même
  // raisonnement que Ride.track (voir ADR-002) : aucune requête spatiale en
  // V1, un JSONB suffit à reconstruire l'itinéraire pour le recalculer ou
  // l'afficher.
  waypoints Json

  avoidHighways Boolean @map("avoid_highways")
  avoidTolls    Boolean @map("avoid_tolls")

  // 'planned' | 'gpx_import' (RouteSource, domain/route.entity.ts).
  source String

  // Calculés côté client au moment de la sauvegarde (le même moteur de
  // routage vient de répondre quelques instants plus tôt) — jamais
  // recalculés par resauter sur Valhalla ici, contrairement au résumé de
  // Ride : un écart mineur sur une distance affichée n'a pas les mêmes
  // conséquences qu'un tracé GPS dont l'authenticité importe.
  distanceMeters      Float?   @map("distance_meters")
  durationSeconds     Float?   @map("duration_seconds")
  elevationGainMeters Float?   @map("elevation_gain_meters")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Tri par récence, filtré par auteur.
  @@index([authorId, createdAt])
  @@map("routes")
}
