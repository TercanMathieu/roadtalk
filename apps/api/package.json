{
  "name": "@roadtalk/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "node --watch -r ts-node/register/transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-fastify": "10.4.15",
    "@prisma/client": "6.2.1",
    "@roadtalk/contracts": "workspace:*",
    "@roadtalk/domain-shared": "workspace:*",
    "dotenv": "17.4.2",
    "fastify": "4.28.1",
    "jose": "6.2.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@roadtalk/config": "workspace:*",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "22.10.5",
    "eslint-plugin-boundaries": "5.0.1",
    "prisma": "6.2.1",
    "testcontainers": "12.1.0",
    "ts-node": "10.9.2",
    "vitest": "2.1.8"
  }
}
