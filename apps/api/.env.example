DATABASE_URL=postgres://roadtalk:roadtalk_dev@localhost:5432/roadtalk
PORT=3000
# Générer une paire avec : node -e "..." (voir README) — EdDSA/Ed25519, format PEM PKCS8/SPKI.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Google Cloud Console → OAuth Client ID (type "Web" ou "iOS"/"Android" selon le flow mobile).
GOOGLE_OAUTH_CLIENT_ID=
# Bundle ID / Services ID enregistré pour "Sign in with Apple" (nécessite Apple Developer Program).
APPLE_CLIENT_ID=
# Génération d'itinéraire par IA (ADR-004). Clé API Anthropic (console.anthropic.com).
# Vide : la génération répond AI_ROUTE_UNAVAILABLE, le reste de l'API fonctionne.
ANTHROPIC_API_KEY=
# Générations autorisées par utilisateur et par 24 h glissantes (coût, C5).
AI_ROUTE_DAILY_LIMIT=5
